{
  "schemaVersion": 1,
  "id": "hana-printer",
  "version": "${version}",
  "name": "Hana TGP Printer",
  "description": "TGP schematic printer for Meteor Client 26.1.2",
  "authors": ["Fractal420"],
  "contact": {
    "sources": "https://github.com/FantasticGranted/vortex-addon"
  },
  "icon": "assets/litematica-printer/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "me.aleksilassila.litematica.printer.LitematicaPrinterMod"
    ],
    "client": [
      "me.aleksilassila.litematica.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "me.aleksilassila.litematica.printer.config.ModMenu"
    ]
  },
  "accessWidener": "printer.accesswidener",
  "mixins": [
    "litematica-printer.core.mixins.json",
    "litematica-printer.litematica.mixins.json",
    "litematica-printer.malilib.mixins.json",
    "litematica-printer.optional.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,255,220",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*",
    "litematica": "*",
    "malilib": "*"
  }
}
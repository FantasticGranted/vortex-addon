{
  "schemaVersion": 1,
  "id": "superprinter",
  "version": "${version}",
  "name": "Super Printer",
  "description": "Schematic printer (printer + carpet-map walker) addon for Meteor Client 26.1.2.",
  "authors": [
    "numericly"
  ],
  "icon": "assets/superprinter/icon.png",
  "accessWidener": "printer.accesswidener",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "net.numericly.superprinter.SuperPrinter"
    ]
  },
  "mixins": [
    "superprinter.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "255,200,0",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*",
    "litematica": "*",
    "malilib": "*"
  }
}
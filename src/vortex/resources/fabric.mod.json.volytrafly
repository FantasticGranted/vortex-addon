{
  "schemaVersion": 1,
  "id": "volytrafly",
  "version": "${version}",
  "name": "VolytraFly",
  "description": "Elytra flight assist and movement enhancements for Meteor Client 26.1.2",
  "authors": ["Volizray"],
  "contact": {
    "sources": "https://github.com/FantasticGranted/vortex-addon"
  },
  "icon": "assets/volytrafly/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.volytrafly.VolytraFlyAddon"
    ]
  },
  "accessWidener": "printer.accesswidener",
  "mixins": [],
  "custom": {
    "meteor-client:color": "0,255,220",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
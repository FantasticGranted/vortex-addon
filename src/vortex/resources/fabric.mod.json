{
  "schemaVersion": 1,
  "id": "vortex",
  "version": "${version}",
  "name": "Vortex",
  "description": "Vortex addon for Meteor Client 26.1.2 - combat, crystal aura, auto regear, elytra flight, map printer, and more.",
  "authors": [
    "Vortex",
    "Volizray (VolytraFly)",
    "Fragment-Zero (Quiettee Utils)",
    "Quinn (QuinnAddon)",
    "numericly (Super Printer)",
    "Quiettee (Quiettee Utils)",
    "Fractal420 (Hana TGP Printer)"
  ],
  "contact": {
    "sources": "https://github.com/FantasticGranted/vortex-addon"
  },
  "icon": "assets/vortex/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.vortex.Vortex",
      "com.quiettee.utils.QuietteeUtils",
      "net.numericly.superprinter.SuperPrinter",
      "com.volytrafly.VolytraFlyAddon",
      "com.example.addon.QuinnAddon"
    ],
    "main": [
      "com.example.addon.SoundRegistry"
    ],
    "client": [
      "me.aleksilassila.litematica.printer.LitematicaPrinterMod"
    ]
  },
  "accessWidener": "printer.accesswidener",
  "mixins": [
    "vortex_printer.mixins.json",
    "quiettee-utils.mixins.json",
    "addon-template.mixins.json",
    "litematica-printer.core.mixins.json",
    "litematica-printer.litematica.mixins.json",
    "litematica-printer.malilib.mixins.json",
    "litematica-printer.optional.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,255,220",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*",
    "litematica": "*",
    "malilib": "*"
  }
}
